TG_API_ID=123456
TG_API_HASH=replace-with-your-api-hash
# JSON 数组：每项为一个完整的 Shoutrrr URL。
SHOUTRRR_URLS='["bark://:YOUR_DEVICE_KEY@api.day.app/?group=Telegram&sound=healthnotification&url=tg%3A%2F%2F"]'
MY_USERNAME=
PUSH_SELF_MESSAGES=false
# 裸机运行时使用；Compose 会设置 /data 下的路径。
TG_SESSION=data/telegram.session.json
STATE_FILE=data/state.json
# 可选软内存目标，不等同于 RSS 硬上限：
# GOMEMLIMIT=64MiB
